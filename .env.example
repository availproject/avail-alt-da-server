# Address to bind the server to
ADDR=

# Port to run the server on
PORT=

# Avail HTTP RPC URL ( REQUIRED )
AVAIL_RPC=

# Avail seed phrase ( OPTIONAL - defaults to empty string )
AVAIL_SEED=

# Avail App ID (OPTIONAL - defaults to 0)
# This must be set to a valid App ID for your application
AVAIL_APPID=

# Avail timeout in seconds
AVAIL_TIMEOUT=


# Turbo DA Configuration
AVAIL_TURBODA=
AVAIL_TURBODA_URL=
AVAIL_TURBODA_KEY=

